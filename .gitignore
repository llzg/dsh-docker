# 本地视觉能力（Qwen2.5-VL 本地推理）——不进版本库
.vision-venv/
.vision-models/
.uv-cache/
.llama.cpp/
.vulkan-headers/

# 视觉缓存（含图片 OCR 文本 / 模型回答，可能含敏感内容）——绝不入库
.vision-cache/

# Python 缓存
__pycache__/

# 其他本地临时产物
*.log
*.tgz

# 本地测试依赖
node_modules/

# NAS 侧凭据/钉住文件（由部署脚本生成，不入库）
nas/.env
nas/.env.*
!nas/.env.example

# dsh-mobile 等本地独立仓库 / 诊断脚本 / CI 凭据（绝不可入库）
dsh-mobile/
audit-dsh-mobile/
dsh-test/
.browser-cache/
.ci-tokens.env
.dsh_askpass.sh
.diag_ssh.sh
.known_hosts_diag

# 对齐上游前的自动备份目录
.backup-pre-update-*/
